flowchart LR
  ci["GitHub Actions"]:::job
  subgraph host_host["Host with the cameras (same machine as MediaMTX)"]
    client(["MCP client"]):::actor
    srv["uv run eufy-cam-mcp<br/>stdio, one per client session"]:::app
    mtx{{"MediaMTX<br/>:9997 API, :8554 RTSP"}}:::ext
    ff["ffmpeg<br/>per call, 60 s cap"]:::job
    disk[("Camera folders<br/>SNAP_DIR, REC_DIR")]:::store
  end
  client -->|"stdio"| srv
  srv -->|"HTTP"| mtx
  srv -->|"spawn"| ff
  ff -->|"read / write"| disk
  ci -.->|"ruff, boundary check, pytest"| srv
  classDef actor fill:#fde68a,stroke:#b45309,color:#111827
  classDef app fill:#bfdbfe,stroke:#1d4ed8,color:#0b1220
  classDef ext fill:#e5e7eb,stroke:#4b5563,color:#0b1220,stroke-dasharray:4 3
  classDef job fill:#fbcfe8,stroke:#be185d,color:#0b1220
  classDef store fill:#bbf7d0,stroke:#15803d,color:#0b1220
